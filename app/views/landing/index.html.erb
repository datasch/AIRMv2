<script>
  // Culqi Products Dictionary
  const CULQI_PRODUCTS = {
    pilot_3_days: {
      id: 'pilot_3_days',
      name: 'Piloto Recepcionista IA (3 Días de Validación)',
      image: '/products/pilot-ia.svg',
      pricePEN: 18.00,
      priceCentsPEN: 1800,
      priceUSD: 5.00,
      period: 'pago único por 3 días'
    },
    starter_crm: {
      id: 'starter_crm',
      name: 'Plan AIRM Starter CRM (3 Asesores)',
      image: '/products/starter-crm.svg',
      pricePEN: 149.00,
      priceCentsPEN: 14900,
      priceUSD: 39.00,
      period: 'por mes'
    },
    monthly_maintenance: {
      id: 'monthly_maintenance',
      name: 'Mantenimiento & Continuidad Operativa (IA 24/7)',
      image: '/products/maintenance-cloud.svg',
      pricePEN: 300.00,
      priceCentsPEN: 30000,
      priceUSD: 79.00,
      period: 'por mes'
    },
    pro_automation: {
      id: 'pro_automation',
      name: 'Plan AIRM Professional & Copiloto IA',
      image: '/products/pro-automation.svg',
      pricePEN: 499.00,
      priceCentsPEN: 49900,
      priceUSD: 129.00,
      period: 'por mes'
    },
    full_setup: {
      id: 'full_setup',
      name: 'Implementación Integral & Setup Onboarding',
      image: '/products/setup-onboarding.svg',
      pricePEN: 1500.00,
      priceCentsPEN: 150000,
      priceUSD: 399.00,
      period: 'pago único'
    }
  };

  let activeProduct = CULQI_PRODUCTS.pilot_3_days;
  let activeCurrency = 'PEN';
  let culqiLoaded = false;

  // Currency Switcher
  function switchCurrency(code) {
    activeCurrency = code;
    const penBtn = document.getElementById('cur-btn-pen');
    const usdBtn = document.getElementById('cur-btn-usd');

    if (code === 'PEN') {
      penBtn.className = 'px-4 py-1.5 rounded-lg text-xs font-bold transition-all bg-purple-600 text-white shadow-md';
      usdBtn.className = 'px-4 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition-all';
    } else {
      usdBtn.className = 'px-4 py-1.5 rounded-lg text-xs font-bold transition-all bg-purple-600 text-white shadow-md';
      penBtn.className = 'px-4 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition-all';
    }

    document.querySelectorAll('.price-val').forEach(el => {
      el.textContent = code === 'PEN' ? el.getAttribute('data-pen') : el.getAttribute('data-usd');
    });

    document.querySelectorAll('.alt-price').forEach(el => {
      el.textContent = code === 'PEN' ? el.getAttribute('data-pen') : el.getAttribute('data-usd');
    });
  }

  // Load Culqi Script
  function loadCulqiScript(callback) {
    if (window.Culqi) {
      callback();
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://checkout.culqi.com/js/v4';
    script.async = true;
    script.onload = () => {
      culqiLoaded = true;
      callback();
    };
    script.onerror = () => {
      console.error('Error al cargar Culqi Checkout v4');
    };
    document.head.appendChild(script);
  }

  // Open Checkout Modal
  function openPurchaseModal(productId) {
    activeProduct = CULQI_PRODUCTS[productId] || CULQI_PRODUCTS.pilot_3_days;
    
    document.getElementById('modal-product-img').src = activeProduct.image;
    document.getElementById('modal-product-title').textContent = activeProduct.name;
    document.getElementById('modal-product-price').textContent = 'S/ ' + activeProduct.pricePEN.toFixed(2);
    document.getElementById('modal-product-period').textContent = '(' + activeProduct.period + ')';

    const modal = document.getElementById('checkout-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';

    // Preload Culqi script in background
    loadCulqiScript(() => {});
  }

  // Close Checkout Modal
  function closePurchaseModal() {
    const modal = document.getElementById('checkout-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = 'auto';
  }

  // Execute Culqi Payment
  function executeCulqiPayment() {
    const name = document.getElementById('buyer-name').value.trim();
    const email = document.getElementById('buyer-email').value.trim();
    const phone = document.getElementById('buyer-phone').value.trim();
    const terms = document.getElementById('terms-check').checked;

    if (!name || !email || !phone) {
      alert('Por favor complete todos los datos requeridos.');
      return;
    }

    if (!terms) {
      alert('Debe aceptar los Términos y la Política de Devoluciones.');
      return;
    }

    loadCulqiScript(() => {
      try {
        window.Culqi.publicKey = "<%= @culqi_public_key %>";

        window.Culqi.settings({
          title: activeProduct.name,
          currency: 'PEN',
          amount: activeProduct.priceCentsPEN
        });

        window.Culqi.options({
          lang: 'es',
          installments: true,
          paymentMethods: {
            tarjeta: true,
            yape: true,
            billetera: true,
            bancaMovil: true,
            agente: true,
            cuotealo: false
          }
        });

        window.culqi = function() {
          if (window.Culqi.token) {
            alert('¡Pago procesado con éxito! Se ha enviado la confirmación al correo: ' + email);
            closePurchaseModal();
          } else if (window.Culqi.order) {
            alert('¡Orden generada con éxito! ID: ' + window.Culqi.order.id);
            closePurchaseModal();
          } else if (window.Culqi.error) {
            alert('Aviso de pago: ' + (window.Culqi.error.user_message || window.Culqi.error.message));
          }
          window.Culqi.close();
        };

        window.Culqi.open();
      } catch (err) {
        console.error('Error al inicializar Culqi:', err);
      }
    });
  }

  // Close modal on escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closePurchaseModal();
  });

  // Demo status text
  (function() {
    const statuses = [
      "Escaneando intención...",
      "Calificando con IA...",
      "Respuesta enviada ✓✓"
    ];
    let idx = 0;
    const statusText = document.getElementById('card-status-text');
    if (statusText) {
      setInterval(function() {
        idx = (idx + 1) % statuses.length;
        statusText.textContent = statuses[idx];
      }, 3000);
    }
  })();
</script>
