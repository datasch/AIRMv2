<script>
  // Interactive Simulation for Live Demo
  (function() {
    const statuses = [
      "Escaneando intención...",
      "Calificando con IA...",
      "Respuesta enviada ✓✓"
    ];
    let idx = 0;
    const statusText = document.getElementById('card-status-text');
