      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5">
          <span class="text-xl font-black tracking-tight text-white">AIRM</span>
          <span class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-purple-500/15 text-purple-300 border border-purple-500/30">AI CRM</span>
        </div>
        <span class="text-[9px] font-bold tracking-widest text-slate-400 uppercase -mt-0.5">by Giantucchi</span>
      </div>
