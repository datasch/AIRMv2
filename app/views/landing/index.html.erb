  <div class="relative max-w-5xl w-full flex flex-col items-center">
    <!-- Close Button -->
    <button type="button" onclick="closeLightbox()" class="absolute -top-12 right-0 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-xl transition-all shadow-lg">
      ✕
    </button>
    
    <!-- Image Card -->
    <div class="rounded-2xl overflow-hidden border border-white/20 shadow-2xl bg-[#0b0f19] max-h-[75vh] flex items-center justify-center">
      <img id="lightbox-img" src="" alt="Captura ampliada de AIRM" class="max-h-[73vh] w-auto object-contain rounded-xl" />
    </div>

    <!-- Caption -->
    <div class="mt-4 text-center max-w-2xl px-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[10px] font-bold uppercase tracking-wider mb-1.5">
        ✓ Captura Real de Software en Producción
      </span>
      <h4 id="lightbox-title" class="text-base sm:text-lg font-black text-white">Título del Módulo</h4>
      <p id="lightbox-desc" class="text-xs text-slate-400 mt-1">Descripción detallada</p>
    </div>
  </div>
</div>

<script>
  // Culqi Products Dictionary con capturas reales de la plataforma
  const CULQI_PRODUCTS = {
    full_setup: {
      id: 'full_setup',
      name: 'Implementación Agente IA Omnicanal (AIRM + IAN)',
      image: '/products/airm-ai-captain.png',
      pricePEN: 1500.00,
      priceCentsPEN: 150000,
      priceUSD: 399.00,
      period: 'pago único (incluye 60 días de AIRM gratis)'
    },
    combo_b2b_ia: {
      id: 'combo_b2b_ia',
      name: 'Combo: Lead Gen B2B + Agente IA Omnicanal',
      image: '/products/airm-leadgen-b2b.png',
      pricePEN: 2850.00,
      priceCentsPEN: 285000,
      priceUSD: 770.00,
      period: 'pago único (incluye 2,500 leads B2B + 60 días AIRM)'
    },
    starter_plan: {
      id: 'starter_plan',
      name: 'Plan AIRM Starter (2 Asesores + IA)',
      image: '/products/airm-omnichannel-inbox.png',
      pricePEN: 99.00,
      priceCentsPEN: 9900,
      priceUSD: 27.00,
      period: 'por mes'
    },
    team_growth: {
      id: 'team_growth',
      name: 'Plan AIRM Team Growth (5 Asesores + IA Avanzada)',
      image: '/products/airm-crm-dashboard.png',
      pricePEN: 199.00,
      priceCentsPEN: 19900,
      priceUSD: 54.00,
      period: 'por mes'
    },
    business_pro: {
      id: 'business_pro',
      name: 'Plan AIRM Business Pro & VoIP (10 Asesores + Asterisk)',
      image: '/products/airm-voip-telephony.png',
      pricePEN: 389.00,
      priceCentsPEN: 38900,
      priceUSD: 105.00,
      period: 'por mes'
    }
  };

  let activeProduct = CULQI_PRODUCTS.full_setup;
  let activeCurrency = 'PEN';
  let culqiLoaded = false;

  // Currency Switcher
  function switchCurrency(code) {
    activeCurrency = code;
    const penBtn = document.getElementById('cur-btn-pen');
    const usdBtn = document.getElementById('cur-btn-usd');

    if (code === 'PEN') {
      penBtn.className = 'px-4 py-1.5 rounded-lg text-xs font-bold transition-all bg-purple-600 text-white shadow-md';
      usdBtn.className = 'px-4 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition-all';
    } else {
      usdBtn.className = 'px-4 py-1.5 rounded-lg text-xs font-bold transition-all bg-purple-600 text-white shadow-md';
      penBtn.className = 'px-4 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition-all';
    }

    document.querySelectorAll('.price-val').forEach(el => {
      el.textContent = code === 'PEN' ? el.getAttribute('data-pen') : el.getAttribute('data-usd');
    });

    document.querySelectorAll('.alt-price').forEach(el => {
      el.textContent = code === 'PEN' ? el.getAttribute('data-pen') : el.getAttribute('data-usd');
    });
  }

  // Load Culqi Script
  function loadCulqiScript(callback) {
    if (window.Culqi) {
      callback();
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://checkout.culqi.com/js/v4';
    script.async = true;
    script.onload = () => {
      culqiLoaded = true;
      callback();
    };
    script.onerror = () => {
      console.error('Error al cargar Culqi Checkout v4');
    };
    document.head.appendChild(script);
  }

  // Open Checkout Modal
  function openPurchaseModal(productId) {
    activeProduct = CULQI_PRODUCTS[productId] || CULQI_PRODUCTS.full_setup;
    
    // Reset view to form state
    document.getElementById('checkout-form-container').classList.remove('hidden');
    document.getElementById('checkout-success-container').classList.add('hidden');

    document.getElementById('modal-product-img').src = activeProduct.image;
    document.getElementById('modal-product-title').textContent = activeProduct.name;
    document.getElementById('modal-product-price').textContent = 'S/ ' + activeProduct.pricePEN.toFixed(2);
    document.getElementById('modal-product-period').textContent = '(' + activeProduct.period + ')';

    const modal = document.getElementById('checkout-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';

    // Preload Culqi script in background
    loadCulqiScript(() => {});
  }

  // Close Checkout Modal
  function closePurchaseModal() {
    const modal = document.getElementById('checkout-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    if (document.getElementById('image-lightbox-modal').classList.contains('hidden')) {
      document.body.style.overflow = 'auto';
    }
  }

  // Lightbox Modal Functions (Expand Real Screenshots)
  function openLightbox(src, title, desc) {
    const modal = document.getElementById('image-lightbox-modal');
    document.getElementById('lightbox-img').src = src;
    document.getElementById('lightbox-title').textContent = title;
    document.getElementById('lightbox-desc').textContent = desc;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    const modal = document.getElementById('image-lightbox-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    if (document.getElementById('checkout-modal').classList.contains('hidden')) {
      document.body.style.overflow = 'auto';
    }
  }

  // Close lightbox on click outside
  document.getElementById('image-lightbox-modal').addEventListener('click', function(e) {
    if (e.target === this) closeLightbox();
  });

  // Show Payment Success Screen (Shop Flow)
  function showPaymentSuccessScreen(product, name, email, refCode) {
    document.getElementById('checkout-form-container').classList.add('hidden');
    
    const successBox = document.getElementById('checkout-success-container');
    document.getElementById('success-product-name').textContent = product.name;
    document.getElementById('success-product-price').textContent = 'S/ ' + product.pricePEN.toFixed(2);
    document.getElementById('success-tx-code').textContent = refCode || ('CULQI-' + Date.now().toString(36).toUpperCase());
    document.getElementById('success-buyer-email').textContent = email;

    // Direct account registration link with prefilled parameters
    const signupUrl = '/app/auth/signup?email=' + encodeURIComponent(email) + '&name=' + encodeURIComponent(name) + '&plan=' + encodeURIComponent(product.id);
    document.getElementById('btn-activate-account').href = signupUrl;

    successBox.classList.remove('hidden');
  }

  // Execute Culqi Payment
  function executeCulqiPayment() {
    const name = document.getElementById('buyer-name').value.trim();
    const email = document.getElementById('buyer-email').value.trim();
    const phone = document.getElementById('buyer-phone').value.trim();
    const terms = document.getElementById('terms-check').checked;

    if (!name || !email || !phone) {
      alert('Por favor complete todos los datos requeridos.');
      return;
    }

    if (!terms) {
      alert('Debe aceptar los Términos y la Política de Devoluciones.');
      return;
    }

    loadCulqiScript(() => {
      try {
        window.Culqi.publicKey = "<%= @culqi_public_key %>";

        window.Culqi.settings({
          title: activeProduct.name,
          currency: 'PEN',
          amount: activeProduct.priceCentsPEN
        });

        window.Culqi.options({
          lang: 'es',
          installments: true,
          paymentMethods: {
            tarjeta: true,
            yape: true,
            billetera: true,
            bancaMovil: true,
            agente: true,
            cuotealo: false
          }
        });

        window.culqi = function() {
          if (window.Culqi.token || window.Culqi.order) {
            const refCode = window.Culqi.token ? window.Culqi.token.id : window.Culqi.order.id;
            showPaymentSuccessScreen(activeProduct, name, email, refCode);
          } else if (window.Culqi.error) {
            alert('Aviso de Culqi: ' + (window.Culqi.error.user_message || window.Culqi.error.message));
          }
          window.Culqi.close();
        };

        window.Culqi.open();
      } catch (err) {
        console.error('Error al inicializar Culqi:', err);
      }
    });
  }

  // Close modals on escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeLightbox();
      closePurchaseModal();
    }
  });

  // Demo status text
  (function() {
    const statuses = [
      "Escaneando intención...",
      "Calificando con IA...",
      "Respuesta enviada ✓✓"
    ];
    let idx = 0;
    const statusText = document.getElementById('card-status-text');
    if (statusText) {
      setInterval(function() {
        idx = (idx + 1) % statuses.length;
        statusText.textContent = statuses[idx];
      }, 3000);
    }
  })();
</script>

