<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? yield(:title) : "AIRM by Giantucchi — AI CRM & Automatizaciones Conversacionales" %></title>
  <meta name="description" content="AIRM de Giantucchi: Plataforma integral de gestión de relaciones comerciales potenciada por IA, WhatsApp QR y Cloud API, Instagram, Facebook y automatizaciones empresariales.">
  <link rel="icon" type="image/svg+xml" href="/brand-assets/logo_thumbnail.svg">
  <link rel="shortcut icon" href="/brand-assets/logo_thumbnail.svg">
  <link rel="apple-touch-icon" href="/brand-assets/logo_thumbnail.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              cyan: '#06b6d4',
              blue: '#3b82f6',
              violet: '#8b5cf6',
              purple: '#a855f7',
              magenta: '#ec4899',
              orange: '#f97316',
              yellow: '#eab308',
            },
            dark: {
              bg: '#000000',
              surface: '#050505',
              card: '#0a0a0f',
              elevated: '#141420',
              border: '#1f1f2e',
            }
          },
          backgroundImage: {
            'gradient-brand': 'linear-gradient(135deg, #3b82f6 0%, #8b5cf6 25%, #ec4899 50%, #f97316 75%, #eab308 100%)',
            'gradient-dark': 'linear-gradient(180deg, #000000 0%, #050505 100%)',
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #000000;
      color: #f1f5f9;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      overflow-x: hidden;
    }
    
    .brand-gradient-text {
      background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 25%, #ec4899 50%, #f97316 75%, #eab308 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .brand-gradient-cyan {
      background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 50%, #8b5cf6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .btn-primary {
      background: #ffffff;
      color: #050505;
      font-weight: 700;
      padding: 0.75rem 1.75rem;
      border-radius: 9999px;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 4px 20px rgba(255, 255, 255, 0.12);
    }
    .btn-primary:hover {
      background: rgba(255, 255, 255, 0.92);
      transform: translateY(-1px);
      box-shadow: 0 8px 32px rgba(255, 255, 255, 0.22);
    }

    .btn-ghost {
      background: rgba(255, 255, 255, 0.04);
      color: #e2e8f0;
      font-weight: 600;
      padding: 0.75rem 1.75rem;
      border-radius: 9999px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      backdrop-filter: blur(12px);
    }
    .btn-ghost:hover {
      color: #ffffff;
      border-color: rgba(255, 255, 255, 0.25);
      background: rgba(255, 255, 255, 0.08);
      transform: translateY(-1px);
    }

    .glass-card {
      background: rgba(10, 10, 15, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.07);
      transition: all 0.3s ease;
    }
    .glass-card:hover {
      border-color: rgba(139, 92, 246, 0.35);
      box-shadow: 0 12px 40px -10px rgba(139, 92, 246, 0.15);
    }

    .nav-glass {
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 0.35; transform: scale(1); }
      50% { opacity: 0.75; transform: scale(1.04); }
    }
    .glow-pulse {
      animation: pulse-glow 7s infinite ease-in-out;
    }
  </style>
  <!-- TikTok Pixel Code Start -->
  <script>
  !function (w, d, t) {
    w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(
  var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e},ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js",o=n&&n.partner;ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};n=document.createElement("script")
  ;n.type="text/javascript",n.async=!0,n.src=r+"?sdkid="+e+"&lib="+t;e=document.getElementsByTagName("script")[0];e.parentNode.insertBefore(n,e)};


    ttq.load('DAFLIVBC77U208ULDNIG');
    ttq.page();
  }(window, document, 'ttq');

  // Helper dual para medición sincronizada (Browser Pixel + Server Events API)
  window.trackTikTokDualEvent = function(eventName, properties, userData) {
    properties = properties || {};
    userData = userData || {};

    var eventId = properties.event_id || ('tt_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9));
    properties.event_id = eventId;

    // 1. Medición en navegador mediante Pixel
    if (window.ttq && typeof window.ttq.track === 'function') {
      try {
        window.ttq.track(eventName, properties, { event_id: eventId });
      } catch (e) {
        console.warn('[TikTok Pixel] Error:', e);
      }
    }

    // 2. Medición en servidor mediante Events API (resistente a bloqueadores)
    try {
      var payload = {
        event_name: eventName,
        event_id: eventId,
        properties: properties,
        user: userData
      };
      var jsonPayload = JSON.stringify(payload);
      if (navigator.sendBeacon) {
        var blob = new Blob([jsonPayload], { type: 'application/json' });
        navigator.sendBeacon('/tracking/tiktok_event', blob);
      } else {
        fetch('/tracking/tiktok_event', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: jsonPayload,
          keepalive: true
        }).catch(function() {});
      }
    } catch (err) {
      console.warn('[TikTok Events API] Error:', err);
    }
    return eventId;
  };
  </script>
  <!-- TikTok Pixel Code End -->
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-purple-600 selection:text-white bg-black">
  <%= yield %>
</body>
</html>
