<section class="main-content__body">
 <hr/>
  <%= form_for([:reset_cache, namespace, page.resource], method: :post, html: { class: "form" }) do |f| %>
    <div class="form-actions">
      <p class="pb-3"><%= t('super_admin.accounts.reset_cache_hint', default: 'Esto borrará las claves de caché de IndexedDB en Redis. La próxima carga obtendrá los datos del servidor.') %></p>
      <%= f.submit t('super_admin.actions.reset_cache', default: 'Restablecer Caché del Frontend') %>
    </div>
  <% end %>
</section>
