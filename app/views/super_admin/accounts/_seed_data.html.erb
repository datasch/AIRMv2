<% if ENV.fetch('ENABLE_ACCOUNT_SEEDING', !Rails.env.production?)  %>
<section class="main-content__body">
 <hr/>
  <%= form_for([:seed, namespace, page.resource], method: :post, html: { class: "form" }) do |f| %>

  <div class="form-actions">
    <div class="pb-3">
      <p><%= t('super_admin.accounts.seed_data_hint', default: 'Haga clic en el botón para generar datos de prueba en esta cuenta para demostraciones.') %></p>
      <p class="text-color-red"><%= t('super_admin.accounts.seed_data_warning', default: 'Nota: Esto borrará todos los datos existentes en esta cuenta.') %></p>
    </div>
  <%= f.submit t('super_admin.actions.generate_seed', default: 'Generar Datos de Prueba') %>
  </div>
  <% end %>
</section>
<% end %>
