<li class="px-3 mb-0.5">
  <details class="group" <%= 'open' if open %>>
    <% summary_class = open ? 'text-black dark:text-white bg-slate-200/70 dark:bg-slate-800 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-black dark:hover:text-white hover:bg-slate-200/50 dark:hover:bg-slate-800/50 font-medium' %>
    <summary class="flex items-center px-3 py-2 cursor-pointer rounded-xl <%= summary_class %> list-none transition-all duration-150">
      <%= link_to super_admin_settings_url, class: 'flex items-center flex-1' do %>
        <svg width="18" height="18" class="shrink-0 text-slate-500 dark:text-slate-400"><use xlink:href="#icon-settings-2-line" /></svg>
        <span class="ml-3 text-sm tracking-tight"><%= t('super_admin.navigation.settings', default: 'Configuración') %></span>
      <% end %>
      <svg class="ml-auto w-4 h-4 text-slate-400 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </summary>
    <ul class="ml-4 mt-1 pl-2 border-l border-slate-200 dark:border-slate-800 space-y-0.5">
      <% settings_pages.each do |_feature_key, attrs| %>
        <% url = super_admin_app_config_url(config: attrs['config_key']) %>
        <li>
          <% active = current_page?(url) %>
          <% item_class = active ? 'text-black dark:text-white font-semibold bg-slate-200/60 dark:bg-slate-800/80' : 'text-slate-500 dark:text-slate-400 hover:text-black dark:hover:text-white hover:bg-slate-200/40 dark:hover:bg-slate-800/40' %>
          <%= link_to url, class: item_class + ' flex items-center px-2.5 py-1.5 rounded-lg text-xs transition-colors' do %>
            <span><%= attrs['name'] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </details>
</li>
