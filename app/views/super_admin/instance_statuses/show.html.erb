<% content_for(:title) do %>
  <%= t('super_admin.navigation.instance_health', default: 'Estado de la Instancia') %>
<% end %>
<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>
</header>
<section class="main-content__body">
  <table>
  <tr>
    <th><%= t('super_admin.instance_status.metric', default: 'Métrica') %></th>
    <th><%= t('super_admin.instance_status.value', default: 'Valor') %></th>
  </tr>
  <% @metrics.each do |key,value| %>
   <tr>
   <td> <%= key %> </td>
   <td> <%= value %></td>
  </tr>
  <% end %>
</table>

</section>
