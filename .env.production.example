# Plantilla de Variables de Entorno de Producción para Coolify / Docker Compose

# 1. Clave de Sesiones y Encriptación (Generar cadenas aleatorias únicas)
SECRET_KEY_BASE=cambiar_por_cadena_hexadecimal_larga_64_caracteres
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=cambiar_por_clave_32_bytes_hex
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=cambiar_por_clave_32_bytes_hex
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=cambiar_por_clave_32_bytes_hex

# 2. Dominios Públicos & WhatsApp Gateway
FRONTEND_URL=https://app.giantucchi.com
EVOLUTION_API_KEY=airm_evolution_secret_api_key_2026

# 3. Base de Datos PostgreSQL
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=tu_password_seguro_postgres

# 4. Redis Cache & Workers
REDIS_PASSWORD=tu_password_seguro_redis

# 5. Configuración de Correo SMTP (Opcional para envíos reales)
MAILER_SENDER_EMAIL=AIRM <soporte@giantucchi.com>
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=tu_api_key_smtp
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# 6. Qdrant Vector Database (Para RAG y Agentes IA de n8n)
QDRANT_API_KEY=airm_qdrant_secret_api_key_2026
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

